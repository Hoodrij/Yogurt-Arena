.arena-ui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: white;
    -unity-font-definition: initial;
    -unity-font: url("../../Resources/Art/Fonts/Quicksand-Regular.ttf");
    font-size: 40px;
}

.arena-ui Label {
    margin: 0;
    padding: 0;
}

.health-widget {
    position: absolute;
    left: 50px;
    right: 50px;
    top: 25px;
    height: 50px;
}

.health {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.health-label {
    width: 83.7px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.health-bar {
    flex-grow: 1;
    height: 25px;
    justify-content: center;
}

.health-track, .weapon-track {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background-color: white;
}

.health-fill {
    width: 100%;
    height: 25px;
    background-color: white;
    transition-property: width, background-color, scale;
    transition-duration: 0.1s;
}

.health-fill--damage {
    background-color: rgb(255, 94, 59);
    scale: 1 1.3;
}

.health-fill--heal {
    background-color: rgb(0, 255, 97);
    scale: 1 1.3;
}

.weapon-widget {
    position: absolute;
    right: 50px;
    top: 95.74px;
    width: 158.47px;
    height: 93.04px;
}

.weapon {
    flex-grow: 1;
}

.weapon-label {
    height: 50px;
    -unity-text-align: middle-center;
}

.weapon-bar {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 57.28px;
    height: 25px;
    justify-content: center;
}

.weapon-fill {
    width: 0;
    height: 25px;
    background-color: white;
    transition-property: width;
    transition-duration: 0.1s;
}

.game-over-widget, .game-over {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.game-over {
    visibility: hidden;
    opacity: 0;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.77255);
    transition-property: opacity;
    transition-duration: 0.3s;
}

.game-over--visible {
    visibility: visible;
    opacity: 1;
}

.restart-button {
    position: absolute;
    bottom: 340.37px;
    width: 398.39px;
    height: 93.91px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    background-image: none;
    color: white;
    -unity-font-definition: initial;
    -unity-font: url("../../Resources/Art/Fonts/Quicksand-Regular.ttf");
    font-size: 100px;
    -unity-text-align: middle-center;
}

.restart-button:hover, .restart-button:focus {
    background-color: rgba(1, 1, 1, 0.08);
}

.restart-button:active {
    color: rgb(200, 200, 200);
}

.restart-underline {
    position: absolute;
    bottom: 320.84px;
    width: 434.1px;
    height: 3px;
    background-color: white;
}
